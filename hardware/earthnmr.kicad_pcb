			)
			(justify left mirror)
		)
	)
	(gr_text "1  Wind the coil: 916 turns of AWG 20 in 4 layers on a 89 mm former, 200 mm long (26.8 mH, 8.9 ohm); fill it with 1 litre of water."
		(at 228 27.75 0)
		(layer "B.SilkS")
		(uuid "1e19fdcb-f90e-5826-8de4-d7b2c2df0d8f")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "2  Power: +15 V and -15 V at J1; 6-30 V, up to 3 A, at POLARIZE SUPPLY (a battery is the quietest)."
		(at 228 29.5 0)
		(layer "B.SilkS")
		(uuid "07da8cf0-32a6-5815-86b4-090471e223ec")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "3  Tune SW1 to the protons where you are: f = 42.577 Hz/uT x B.  Claremont, 46.0 uT: 1960 Hz, switches 1 2 4 7 ON."
		(at 228 31.25 0)
		(layer "B.SilkS")
		(uuid "420a1ff8-758d-5621-972e-9f4d6e70037d")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "   Earth's field runs 22-67 uT, 937-2853 Hz: SW1 reaches it everywhere with the coil above."
		(at 228 33 0)
		(layer "B.SilkS")
		(uuid "8149d871-5399-5fd3-840b-6734b38fffdd")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "4  MODE RUN, SEQUENCE TIMER: RV1 sets how long it polarizes, RV2 how long it listens; or drive POLARIZE IN."
		(at 228 34.75 0)
		(layer "B.SilkS")
		(uuid "110a5904-8633-55c7-ae83-95d2ca25a558")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "5  Watch OUT on a scope, triggered on SYNC OUT falling; CAL IN puts a known signal into the tank."
		(at 228 36.5 0)
		(layer "B.SilkS")
		(uuid "767a2c7c-0f43-5d6f-bc72-08471f0c01ce")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "CAUTION: the coil and Q1's drain reach about 130 V for half a millisecond at every switch-off."
		(at 228 38.25 0)
		(layer "B.SilkS")
		(uuid "40c17055-3c46-5998-8194-5d686f2aa4a1")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left mirror)
		)
	)
	(gr_text "Copper: 1 (top) every drawn wire; 2 ground; 3 +15 V; 4 -15 V and the three hops."
		(at 228 40 0)
		(layer "B.SilkS")
		(uuid "17b3d7ef-ae11-5557-9f07-ba2d97b79fa5")
		(effects
